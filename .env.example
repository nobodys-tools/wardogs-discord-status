# --- Discord ---------------------------------------------------------------
# Bot token from https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=
# Optional: your Discord server (guild) id. If set, /wd commands appear instantly in that guild only.
# If empty, commands are registered globally (can take up to 1 hour to show up).
DISCORD_GUILD_ID=
# Guilds allowed to add/edit/remove servers (i.e. handle RCON passwords), comma-separated.
# Defaults to DISCORD_GUILD_ID. Panels can be created in any guild the bot is in. If both are empty,
# every guild the bot is in may manage servers — only do that if you control all of those guilds.
ADMIN_GUILD_IDS=

# --- Polling ---------------------------------------------------------------
# Seconds between RCON polls (min 10). Every poll stores a sample for the 24h graph.
POLL_INTERVAL=30
# Days of history to keep in the database.
HISTORY_DAYS=7
RCON_TIMEOUT_MS=8000

# --- Panel defaults --------------------------------------------------------
# Image URL shown at the top of every panel that doesn't set its own banner.
DEFAULT_BANNER_URL=
# Accent colour (left bar + chart line) for panels without their own colour.
DEFAULT_COLOR=#b91c1c

# --- Optional web UI -------------------------------------------------------
# Browser admin at http://<host>:WEB_PORT (HTTP basic auth). Leave WEB_ENABLED=false if you only use /wd commands.
WEB_ENABLED=false
WEB_PORT=8080
# Host interface the Docker port is published on: 127.0.0.1 (this machine only, default) or 0.0.0.0 (LAN).
WEB_BIND=127.0.0.1
WEB_USER=admin
WEB_PASSWORD=
# Public https URL of the web UI (behind your reverse proxy). Enables the "Connect" button on panels
# for servers that have a game address set (Discord can't link steam:// directly, so it goes via /connect/<id>).
PUBLIC_URL=
